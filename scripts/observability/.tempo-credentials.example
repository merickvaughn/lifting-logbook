# Grafana Cloud Tempo query credentials — copy to `.tempo-credentials` and fill in.
#
#   cp scripts/observability/.tempo-credentials.example scripts/observability/.tempo-credentials
#
# `.tempo-credentials` is gitignored. NEVER put real tokens in this `.example`
# file or anywhere else that is committed.
#
# PREFER `tempo-setup.sh` OVER THIS FILE. Running
#
#   source scripts/observability/tempo-setup.sh
#
# prompts for the same values (token input hidden) and persists them to ~/.bashrc, which
# lives outside every checkout and worktree. That matters because a linked git worktree
# carries its own copy of this directory: a credentials file only ever exists in the one
# checkout it was created in, and a worktree under `.claude/worktrees/` can be deleted by
# routine housekeeping — which is exactly how the only read credential on a machine once
# came to be one prune away from gone (#949). Environment variables resolve from ANY
# worktree; a file does not.
#
# If you do use this file, put it in the CANONICAL checkout rather than a worktree.
# tempo-query-env.sh falls back to the canonical checkout's copy when the local one is
# absent, so one file there serves every worktree (#949).
#
# Scope: READ-ONLY trace queries. The token below must be an Access Policy token
# scoped to `traces:read` ONLY — the tempo-query.sh helper issues nothing but HTTP
# GETs against Tempo's read endpoints, so a write/ingest scope is never required.
# The OTLP push tokens held in GCP Secret Manager
# (`lifting-logbook-{stg,prod}-otel-otlp-auth-header`) are WRITE-ONLY — their access
# policy grants `metrics:write, logs:write, traces:write` with no `traces:read` — so they
# cannot be reused here. A distinct read token is genuinely required (#949).
#
# ONE STACK SERVES BOTH ENVIRONMENTS. Staging and production push to the same Grafana
# Cloud stack (a single OTLP instance), so the staging credential set below already reads
# production traces; `deployment.environment.name` is the only discriminator. Scope your
# TraceQL to the environment you mean:
#     { resource.deployment.environment.name = "production" }
# tempo-query-env.sh picks a credential set with TEMPO_TARGET (default `staging`):
#     source scripts/observability/tempo-query-env.sh               # staging
#     TEMPO_TARGET=prod source scripts/observability/tempo-query-env.sh
# `prod` falls back to the staging set below when no TEMPO_PROD_* block is configured, so
# the prod path works on the current one-stack topology without duplicating a token. Fill
# in the TEMPO_PROD_* block only if a genuinely separate prod stack is ever provisioned —
# a filled block takes precedence over the fallback.
#
# Where to find each value (Grafana Cloud portal -> your stack -> Tempo -> "Sending
# Data", or the Tempo data source details page):
#   *_ADDRESS   The Tempo QUERY base URL — the base under which the read API lives so
#               that "${ADDRESS}/api/search" resolves. Depending on your stack this is
#               either
#                   https://tempo-prod-XX-prod-REGION.grafana.net
#               or the same host with a "/tempo" suffix
#                   https://tempo-prod-XX-prod-REGION.grafana.net/tempo
#               Use whichever makes "${ADDRESS}/api/search" a valid endpoint — the
#               `tempo-query.sh tags` smoke test confirms it. This is the Tempo query
#               host, NOT the otlp-gateway push endpoint the collector writes to.
#   *_API_USER  The numeric instance / user ID shown next to that URL.
#   *_API_KEY   An Access Policy token scoped to `traces:read`
#               (Grafana Cloud Account -> Access Policies -> create a token; add the
#               `traces:read` scope for the relevant stack, nothing else).
#
# Optional:
#   *_TENANT_ID  X-Scope-OrgID header value — self-hosted Tempo only. Leave unset for
#               Grafana Cloud (the basic-auth user carries tenancy).

# --- Staging (primary target; on the current shared stack this reads prod too) ---
export TEMPO_STAGING_ADDRESS="https://tempo-prod-XX-prod-REGION.grafana.net"
export TEMPO_STAGING_API_USER="123456"
export TEMPO_STAGING_API_KEY="glc_REPLACE_WITH_A_traces_read_TOKEN"
# export TEMPO_STAGING_TENANT_ID=""

# --- Production (leave commented unless a SEPARATE prod stack exists) ---
# Not needed on the current topology: one stack serves both environments, so
# TEMPO_TARGET=prod falls back to the staging set above. Uncomment only to point prod
# queries at a different stack — a filled block overrides the fallback.
# export TEMPO_PROD_ADDRESS="https://tempo-prod-XX-prod-REGION.grafana.net"
# export TEMPO_PROD_API_USER="123456"
# export TEMPO_PROD_API_KEY="glc_REPLACE_WITH_A_traces_read_TOKEN"
# export TEMPO_PROD_TENANT_ID=""
