{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-check gate for apps/api/scripts/, run by the `typecheck` task as
  // `tsc --noEmit -p tsconfig.typecheck.json`. Deliberately scripts-only, not
  // whole-workspace (unlike the web/core/api-client typecheck precedents this
  // otherwise mirrors): a whole-workspace include drags in 31 pre-existing, unrelated
  // type errors across 12 files in src/**/*.spec.ts (mock shapes trailing behind their
  // interfaces, exactOptionalPropertyTypes friction, Fastify .inject() typing drift)
  // that nest build has always silently skipped via tsconfig.build.json's
  // **/*.spec.ts exclusion. Fixing those is out of scope for #887 — tracked in #890.
  // TypeScript still fully checks whatever scripts/ actually imports from src/ or
  // packages/*, transitively, as part of this program. Resolves @lifting-logbook/*
  // to SOURCE (not node_modules -> dist) so the check needs no upstream build,
  // mirroring packages/core/tsconfig.spec.json and
  // packages/api-client/tsconfig.typecheck.json. See #887 / #651 / #656.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // rootDir at the repo root + composite:false: scripts/'s cross-boundary imports
    // into ../src/adapters/prisma/* and the remapped @lifting-logbook/* source both
    // fall outside the base tsconfig's rootDir:"src", which would otherwise raise
    // TS6059. composite:false is a no-op today (neither tsconfig.base.json nor
    // tsconfig.json sets composite:true) but kept for consistency with the other
    // workspaces' typecheck configs.
    "composite": false,
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "@lifting-logbook/core": ["../../packages/core/src/index.ts"],
      "@lifting-logbook/types": ["../../packages/types/src/index.ts"],
      // packages/core's own source uses these internal aliases (see its
      // tsconfig.json). Once @lifting-logbook/core above pulls packages/core/src/**
      // into this program transitively, those internal imports need resolving too —
      // same two entries apps/web/tsconfig.typecheck.json already carries.
      "@src/core": ["../../packages/core/src/index.ts"],
      "@src/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
