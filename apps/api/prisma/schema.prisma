generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LiftRecord {
  id            String   @id @default(cuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  date          DateTime @db.Date
  lift          String
  // Which occurrence of `lift` in its workout the set belongs to, from 0: a program
  // can plan one lift twice in a day, and each occurrence logs its own sets (#1027).
  occurrence    Int      @default(0)
  setNum        Int
  weight        Float
  reps          Int
  notes         String   @default("")
  // The ids of the lift_modification rows on for this set; empty means unmodified (#1151).
  // Not part of the natural key: it is still set N of this lift.
  modifications String[] @default([])

  @@unique([userId, program, macrocycleNum, workoutNum, date, lift, occurrence, setNum])
  @@index([userId, program, macrocycleNum])
  @@index([userId, program, macrocycleNum, workoutNum])
  // A focus block summary reads one user's records for its pool lifts up to its last day,
  // across programs (#1056).
  @@index([userId, lift, date])
  @@map("lift_record")
}

model TrainingMax {
  id          String   @id @default(cuid())
  userId      String
  program     String
  lift        String
  weight      Float
  dateUpdated DateTime

  @@unique([userId, program, lift])
  @@index([userId, program])
  @@map("training_max")
}

model MacrocycleDashboard {
  id                     String   @id @default(cuid())
  userId                 String
  program                String
  macrocycleUnit         String
  macrocycleNum          Int
  macrocycleDate         DateTime
  sheetName              String
  macrocycleStartWeekday String
  programType            String?

  @@unique([userId, program])
  @@index([userId, program])
  @@map("macrocycle_dashboard")
}

model TrainingMaxHistory {
  id        String   @id @default(cuid())
  userId    String
  program   String
  lift      String
  weight    Float
  reps      Int      @default(1)
  date      DateTime
  isPR      Boolean  @default(false)
  source    String
  goalMet   Boolean  @default(false)
  createdAt DateTime @default(now())
  // Set on a modification's own-max entry (#1153). Null is the lift's own history, and the
  // history reads filter to it.
  modificationId String?

  @@index([userId, program])
  @@index([userId, program, lift])
  @@map("training_max_history")
}

model BodyWeight {
  id        String   @id @default(uuid())
  userId    String
  program   String
  date      DateTime @db.Date
  weight    Float
  unit      String
  createdAt DateTime @default(now())

  @@index([userId, program])
  @@map("body_weight")
}

model StrengthGoal {
  id        String   @id @default(cuid())
  userId    String
  program   String
  lift      String
  goalType  String   @default("relative")
  target    Float?
  unit      String
  ratio     Float?
  updatedAt DateTime @updatedAt

  @@unique([userId, program, lift])
  @@index([userId, program])
  @@map("strength_goal")
}

model WorkoutDateOverride {
  id            String   @id @default(cuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  newDate       DateTime
  createdAt     DateTime @default(now())

  @@unique([userId, program, macrocycleNum, workoutNum])
  @@index([userId, program, macrocycleNum])
  @@map("workout_date_override")
}

model WorkoutSkipOverride {
  id            String   @id @default(uuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  reason        String?
  skippedAt     DateTime @default(now())

  @@unique([userId, program, macrocycleNum, workoutNum])
  @@index([userId, program, macrocycleNum])
  @@map("workout_skip_override")
}

model WorkoutLiftOverride {
  id            String   @id @default(cuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  lift          String
  action        String
  replacedBy    String?
  createdAt     DateTime @default(now())

  // One row per lift and action: a lift's add and its replace are kept apart, so
  // replacing an added lift keeps the add (#1026). Saving a lift's add deletes its
  // remove and vice versa (sameKindActions in the port); only two racing saves can
  // leave both, and then the later write applies last.
  @@unique([userId, program, macrocycleNum, workoutNum, lift, action])
  @@index([userId, program, macrocycleNum, workoutNum])
  @@map("workout_lift_override")
}

model LiftMetadata {
  id            String   @id @default(uuid())
  userId        String
  lift          String
  muscleGroups  String[]
  substitutions String[]
  foundational  Boolean  @default(false)
  // The lift's own progression (#1210, ADR-043). Null falls through to the lifter's default,
  // then the catalog's. `progression` is one of LIFT_PROGRESSION_TYPES, checked by the DTO.
  progression          String?
  progressionIncrement Float?
  repsLow              Int?
  repsHigh             Int?

  @@unique([userId, lift])
  @@index([userId])
  @@map("lift_metadata")
}

model CustomLift {
  id                    String   @id @default(uuid())
  userId                String
  name                  String
  classification        String
  // MovementProfile, stored as separate columns
  // (see docs/proposals/2026-06-03-lift-movement-profiles.md, issue #427).
  // `patterns` was renamed from the former `movementTags` column.
  patterns              String[]
  jointActions          String[]
  complexity            String   @default("simple")
  isBodyweightComponent Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("custom_lift")
}

// A change to how a lift is performed, linked to that lift (#1151, ADR-041).
model LiftModification {
  id               String    @id @default(uuid())
  userId           String
  // The lift's id: a catalog id or a custom lift's uuid, written through lookupLift. No foreign
  // key, because catalog lifts are not rows.
  lift             String
  name             String
  description      String    @default("")
  // 'none' | 'lift' | 'own', with a CHECK constraint
  maxMode          String    @default("none")
  // Sheet spellings that mean this lift with this modification on. Nothing writes them until
  // import does (#1154).
  alternativeNames String[]  @default([])
  // Set when a delete finds a logged set still naming it: hidden from the list, still named on
  // those sets.
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  maxes            LiftModificationMax[]

  @@unique([userId, lift, name])
  @@map("lift_modification")
}

// A modification's own training max (#1153), scoped to a program the way training_max is. A side
// table rather than a row in training_max, so readers that look a max up by lift are unaffected.
model LiftModificationMax {
  id             String           @id @default(cuid())
  userId         String
  program        String
  modificationId String
  weight         Float
  dateUpdated    DateTime
  modification   LiftModification @relation(fields: [modificationId], references: [id], onDelete: Cascade)

  @@unique([userId, program, modificationId])
  @@index([modificationId])
  @@map("lift_modification_max")
}

model UserSettings {
  userId                 String  @id
  activeProgram          String?
  workoutSchedule        Json?
  defaultWeightIncrement Float?
  unit                   String?
  // The daily focus guide (#1056). Null falls back to DEFAULT_FOCUS_BUDGET.
  focusBudgetSets        Int?
  focusBudgetMinutes     Int?
  // The lifter's default progression (#1210, ADR-043). Null `defaultProgression` means each
  // lift's catalog default applies; the other three are meaningful only when it is set.
  defaultProgression          String?
  defaultProgressionIncrement Float?
  defaultProgressionRepsLow   Int?
  defaultProgressionRepsHigh  Int?

  @@map("user_settings")
}

// A focus block (#1053, #1056): accessory work for one muscle area over a calendar month or
// quarter, on a timeline separate from the program. Status (queued/active/ended) is derived
// from `start`, `period` and `align` on every read and never stored (ADR-039).
model FocusBlock {
  id          String   @id @default(uuid())
  userId      String
  // Blocks that roll into one another share a series.
  series      String
  area        String
  period      String
  align       String
  start       DateTime @db.Date
  selection   String
  overlap     String
  progression String
  // 1 is the highest priority.
  priority    Int
  // FocusTimer and FocusPoolEntry[], validated by the DTOs on write and on read.
  timer       Json
  onEnd       String
  nextArea    String?
  pool        Json
  createdAt   DateTime @default(now())

  // Keeps an auto-roll successor, created on read, from being created twice.
  @@unique([userId, series, start])
  @@index([userId])
  @@map("focus_block")
}

// A user's per-workout focus choices (FocusDayState), keyed like the workout override
// side-tables.
model FocusDayState {
  id            String   @id @default(uuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  state         Json
  updatedAt     DateTime @updatedAt

  @@unique([userId, program, macrocycleNum, workoutNum])
  @@map("focus_day_state")
}

model MacrocycleScheduledWorkout {
  id            String   @id @default(uuid())
  userId        String
  program       String
  macrocycleNum Int
  workoutNum    Int
  weekNum       Int
  scheduledDate DateTime @db.Date

  @@unique([userId, program, macrocycleNum, workoutNum])
  @@index([userId, program, macrocycleNum])
  @@map("macrocycle_scheduled_workout")
}

// One row per macrocycle a user has, past and current (#1171, #1197; ADR-042).
// `macrocycle_dashboard` still points at the current one. The seven tables that hold a
// macrocycleNum (lift_record, macrocycle_dashboard, the three workout override tables,
// focus_day_state, macrocycle_scheduled_workout) key on (userId, program, macrocycleNum),
// so this row's `id` is the macrocycle's only stable identity once numbers follow dates.
model Macrocycle {
  id              String    @id @default(uuid())
  userId          String
  program         String
  macrocycleNum   Int
  startDate       DateTime  @db.Date
  // Null while the macrocycle is current, or when nothing dates its end.
  endDate         DateTime? @db.Date
  // completed | abandoned | overran | in-progress | unknown
  status          String
  // The lifter set `status` themselves, so no rule may change it.
  statusChosen    Boolean   @default(false)
  // imported | live | legacy | non-cycle
  origin          String
  // Its lifts don't all belong to a known program (proposal decision 9).
  unmatched       Boolean   @default(false)
  // A continued imported run's sets dated up to here came from the file (#1180).
  importedThrough DateTime? @db.Date
  createdAt       DateTime  @default(now())
  // Its number before #1200's migration numbered history by start date, and when that ran, for
  // `macrocycle_renumber_reverse()`. Null on a macrocycle created after it.
  backfillNumber  Int?
  backfilledAt    DateTime?
  // When that migration closed it: the old revision had left it open on a number the dashboard
  // no longer showed. The reversal leaves it closed.
  backfillClosedAt DateTime?

  @@unique([userId, program, macrocycleNum])
  @@index([userId, program, startDate])
  @@map("macrocycle")
}

model CustomProgram {
  id           String              @id @default(uuid())
  userId       String
  name         String
  description  String?
  baseTemplate String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  specs        CustomProgramSpec[]

  @@index([userId])
  @@map("custom_program")
}

model CustomProgramSpec {
  id             String        @id @default(uuid())
  programId      String
  week           Int
  offset         Int           @default(0)
  lift           String
  increment      Float
  order          Int
  sets           Int
  reps           Int
  amrap          Boolean       @default(false)
  warmUpPct      String
  wtDecrementPct Float
  activation     String
  weekType       String?
  // The row's progression override (#1210, ADR-043). Rows that existed before it were
  // backfilled to `amrap_gated`; a new row may leave it null and follow the lift's value.
  progression    String?
  repsLow        Int?
  program        CustomProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Enforces the natural key the import path keys on, so two concurrent imports of
  // the same file cannot both find-then-create a duplicate row (issue #488).
  @@unique([programId, week, offset, lift, order])
  @@index([programId])
  @@map("custom_program_spec")
}

model ImportBatch {
  id          String   @id @default(uuid())
  userId      String
  program     String
  destination String
  preImage    Json
  createdAt   DateTime @default(now())
  // The Source program's batch of the same import, which undoes this one with it (#1254).
  groupId     String?

  @@index([userId, program])
  @@index([userId, groupId])
  @@map("import_batch")
}
